<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:theme="@style/Theme.UxResources">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/margin_guide_top" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/margin_guide_left" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/margin_guide_right" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="@dimen/margin_guide_bottom" />

    <TextView
        android:id="@+id/fixed_title"
        style="@style/ArcTitleAccessibility"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:layout_marginTop="@dimen/margin_top_cless_bar"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop"
        tools:ignore="TextContrastCheck" />

    <TextView
        android:id="@+id/pin_digits_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/pin_ada_entry_box_margin_top"
        android:background="@drawable/background_edit_text"
        android:fontFamily="@font/robotomono_bold"
        android:longClickable="false"
        android:maxLines="1"
        android:padding="@dimen/pin_ada_entry_box_padding"
        android:singleLine="true"
        android:textAlignment="center"
        android:textSize="@dimen/pin_ada_entry_box_text_size"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@+id/fixed_title"
        tools:ignore="Autofill,LabelFor" />

    <com.ingenico.retail.ui.x.server.forms.view.PinKeypadLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/pin_keypad_layout_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnOne"
            style="@style/PinLayoutButtonAccessibility"
            android:text="1"
            app:layout_constraintEnd_toStartOf="@id/BtnTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnTwo"
            style="@style/PinLayoutButtonAccessibility"
            android:text="2"
            app:layout_constraintEnd_toStartOf="@id/BtnThree"
            app:layout_constraintStart_toEndOf="@id/BtnOne"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnThree"
            style="@style/PinLayoutButtonAccessibility"
            android:text="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnTwo"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnFour"
            style="@style/PinLayoutButtonAccessibility"
            android:text="4"
            app:layout_constraintEnd_toStartOf="@id/BtnFive"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnOne"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnFive"
            style="@style/PinLayoutButtonAccessibility"
            android:text="5"
            app:layout_constraintEnd_toStartOf="@id/BtnSix"
            app:layout_constraintStart_toEndOf="@id/BtnFour"
            app:layout_constraintTop_toBottomOf="@id/BtnTwo"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnSix"
            style="@style/PinLayoutButtonAccessibility"
            android:text="6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnFive"
            app:layout_constraintTop_toBottomOf="@id/BtnThree"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnSeven"
            style="@style/PinLayoutButtonAccessibility"
            android:text="7"
            app:layout_constraintEnd_toStartOf="@id/BtnEight"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnFour"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnEight"
            style="@style/PinLayoutButtonAccessibility"
            android:text="8"
            app:layout_constraintEnd_toStartOf="@id/BtnNine"
            app:layout_constraintStart_toEndOf="@id/BtnSeven"
            app:layout_constraintTop_toBottomOf="@id/BtnFive"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnNine"
            style="@style/PinLayoutButtonAccessibility"
            android:text="9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnEight"
            app:layout_constraintTop_toBottomOf="@id/BtnSix"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnZero"
            style="@style/PinLayoutButtonAccessibility"
            android:layout_height="@dimen/pin_button_height"
            android:layout_margin="0dp"
            android:text="0"
            app:layout_constraintEnd_toEndOf="@id/ButtonBackspace"
            app:layout_constraintStart_toStartOf="@id/ButtonBackspace"
            app:layout_constraintTop_toTopOf="@id/ButtonCancel"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/pin_keypad_big_button_height"
            android:layout_margin="6dp"
            android:layout_marginHorizontal="@dimen/pin_keypad_layout_margin"
            android:background="@color/black"
            android:focusable="false"
            android:gravity="end"
            android:paddingEnd="15dp"
            android:text="x"
            android:textColor="@color/white"
            android:textSize="45sp"
            app:layout_constraintEnd_toStartOf="@id/ButtonBackspace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnSeven"
            tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonBackspace"
            android:layout_width="0dp"
            android:layout_height="@dimen/pin_button_height"
            android:layout_margin="6dp"
            android:background="@color/black"
            android:focusable="false"
            android:gravity="end"
            android:paddingEnd="15dp"
            android:text="&#60;"
            android:textColor="@color/white"
            android:textSize="45sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constraintEnd_toStartOf="@id/ButtonEnter"
            app:layout_constraintStart_toEndOf="@id/ButtonCancel"
            app:layout_constraintTop_toBottomOf="@id/BtnZero"
            tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonEnter"
            android:layout_width="0dp"
            android:layout_height="@dimen/pin_keypad_big_button_height"
            android:layout_margin="6dp"
            android:background="@color/black"
            android:focusable="false"
            android:gravity="end"
            android:paddingEnd="15dp"
            android:text="o"
            android:textColor="@color/white"
            android:textSize="45sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ButtonBackspace"
            app:layout_constraintTop_toBottomOf="@id/BtnNine"
            tools:ignore="ContentDescription,HardcodedText,RtlSymmetry,TextContrastCheck" />

    </com.ingenico.retail.ui.x.server.forms.view.PinKeypadLayout>

</androidx.constraintlayout.widget.ConstraintLayout>