<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Form"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D7D7D7"
    tools:ignore="HardcodedText">
    
    <View
        android:id="@+id/image1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D7D7D7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/PROMPT6"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Select payment type"
            android:textColor="#3C3C3C"
            android:textSize="24sp"
            tools:text="Select payment type" />

        <FrameLayout
            android:id="@+id/image3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/linedisplay1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:fontFamily="monospace"
                android:gravity="start|top"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:padding="14dp"
                android:scrollbars="vertical"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Item description&#10;$0.00" />

        </FrameLayout>

        <!-- K3Z button order: H, C, D, G, B, A -->
        <LinearLayout
            android:id="@+id/paymentButtonRow"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="6">

            <Button
                android:id="@+id/btnh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="H"
                android:text="STORE"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="C"
                android:text="EBT&#10;CASH"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="D"
                android:text="EBT&#10;FOOD"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btng"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="G"
                android:text="STORE"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="B"
                android:text="CREDIT"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!--
                K3Z:
                id="btna"
                buttonid="'A'"
                buttontext="105"
                upimage="B-Debit-U.png"
                downimage="B-Debit-D.png"
            -->
            <Button
                android:id="@+id/btna"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F5A000"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:tag="A"
                android:text="DEBIT"
                android:textAllCaps="false"
                android:textColor="#3C3C3C"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>