<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?background"
    android:theme="@style/Theme.UxResources">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/margin_guide_top" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/margin_guide_left" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/margin_guide_right" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="@dimen/margin_guide_bottom" />

    <ImageView
        android:id="@+id/backgroundLeft"
        style="@style/ArcBackgroundImageLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/background_left_horizontal_bias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/background_left_vertical_bias"
        app:srcCompat="@drawable/background_left"
        tools:ignore="ContentDescription,ImageContrastCheck" />

    <ImageView
        android:id="@+id/backgroundRight"
        style="@style/ArcBackgroundImageRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/background_right_horizontal_bias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/background_right_vertical_bias"
        app:srcCompat="@drawable/background_right"
        tools:ignore="ContentDescription,ImageContrastCheck" />

    <ImageView
        android:id="@+id/backgroundBottom"
        style="@style/ArcBackgroundImageBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/background_bottom_horizontal_bias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/background_bottom_vertical_bias"
        app:srcCompat="@drawable/background_bottom"
        tools:ignore="ContentDescription,ImageContrastCheck" />

    <TextView
        android:id="@+id/fixed_title"
        style="@style/ArcTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:layout_marginTop="@dimen/margin_top_cless_bar"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop"
        tools:ignore="TextContrastCheck" />

    <TextView
        android:id="@+id/pin_digits_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/pin_ada_entry_box_margin_top"
        android:background="@drawable/background_edit_text"
        android:fontFamily="@font/robotomono_bold"
        android:longClickable="false"
        android:maxLines="1"
        android:padding="@dimen/pin_ada_entry_box_padding"
        android:singleLine="true"
        android:textAlignment="center"
        android:textSize="@dimen/pin_ada_entry_box_text_size"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@+id/fixed_title"
        tools:ignore="Autofill,LabelFor" />

    <com.ingenico.retail.ui.x.server.forms.view.PinKeypadLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidelineLeft"
        app:layout_constraintEnd_toEndOf="@id/guidelineRight">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnOne"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="1"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintEnd_toStartOf="@id/BtnTwo"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnFour"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnTwo"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="2"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintEnd_toStartOf="@id/BtnThree"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/BtnOne"
            app:layout_constraintTop_toBottomOf="@id/BtnFive"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnThree"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="3"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnTwo"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toBottomOf="@id/BtnSix"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnFour"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="4"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/BtnFive"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnSeven"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnFive"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="5"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@id/BtnSix"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/BtnFour"
            app:layout_constraintTop_toBottomOf="@id/BtnEight"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnSix"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="6"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnFive"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toBottomOf="@id/BtnNine"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnSeven"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="7"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/BtnEight"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/BtnZero"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnEight"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="8"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@id/BtnNine"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/BtnSeven"
            app:layout_constraintTop_toBottomOf="@id/BtnZero"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnNine"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="9"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/BtnEight"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toBottomOf="@id/BtnZero"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BtnZero"
            style="@style/PortraitPinLayoutAdaButtonDigit"
            android:text="0"
            android:textSize="16sp"
            android:layout_height="25dp"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toStartOf="@id/ButtonClear"
            app:layout_constraintStart_toEndOf="@id/ButtonEnter"
            app:layout_constraintTop_toBottomOf="@id/ButtonBackspace"
            app:layout_constraintBottom_toTopOf="@id/BtnEight"
            tools:ignore="HardcodedText,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonClear"
            style="@style/PortraitPinLayoutAdaButtonControl"
            android:background="@drawable/keypad_button_cancel"
            android:text="x"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonBackspace"
            style="@style/PortraitPinLayoutAdaButtonControl"
            android:background="@drawable/keypad_button_backspace"
            android:text="&#60;"
            android:textSize="16sp"
            android:layout_height="25dp"
            app:layout_constraintEnd_toStartOf="@id/ButtonClear"
            app:layout_constraintStart_toEndOf="@id/ButtonEnter"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ButtonEnter"
            style="@style/PortraitPinLayoutAdaButtonControl"
            android:background="@drawable/keypad_button_enter"
            android:layout_marginEnd="8dp"
            android:text="o"
            app:layout_constraintStart_toStartOf="@id/BtnSeven"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,HardcodedText,RtlSymmetry,TextContrastCheck"
            tools:visibility="visible" />

    </com.ingenico.retail.ui.x.server.forms.view.PinKeypadLayout>

</androidx.constraintlayout.widget.ConstraintLayout>