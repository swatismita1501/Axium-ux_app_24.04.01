<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ingenico_btn_no_color" />
            <corners android:radius="@dimen/pin_layout_button_radius" />
            <stroke android:width="@dimen/pin_layout_button_stroke_width" android:color="@android:color/black" />
        </shape>

    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ingenico_btn_no_color" />
            <corners android:radius="@dimen/pin_layout_button_radius" />
            <stroke android:width="@dimen/pin_layout_button_stroke_width" android:color="@android:color/black" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ingenico_btn_no_color" />
            <corners android:radius="@dimen/pin_layout_button_radius" />
            <stroke android:width="@dimen/pin_layout_button_stroke_width" android:color="@android:color/black" />
        </shape>
    </item>
</selector>

